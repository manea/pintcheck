[Unit]
Description=PINTCheck UAE PINT-AE Pre-Flight E-Invoicing Validator & ASP Readiness Studio
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pintcheck
EnvironmentFile=/etc/pintcheck/.env
ExecStart=/usr/bin/node --no-warnings /opt/pintcheck/server/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
